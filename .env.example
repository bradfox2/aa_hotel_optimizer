# Copy to .env. Never commit real credentials.
LP_ENVIRONMENT=development
LP_PUBLIC_URL=http://127.0.0.1:8787
LP_DATABASE_URL=sqlite:///.local/optimizer.sqlite3

# Live browser searches are opt-in during development. No provider secrets here.
LP_PROVIDER_ENABLED=false
LP_MAX_PROVIDER_CALLS=1000
LP_COMPANION_URL=

# Membership prices come from Stripe. The display label must match that price.
LP_FREE_SEARCHES=2
LP_TRIP_PASS_SEARCHES=20
LP_PAID_SEARCHES_PER_MONTH=100
LP_PLAN_LABEL=Membership
LP_PLAN_PRICE_LABEL=$19/month
LP_TRIP_PASS_PRICE_LABEL=$9
LP_STRIPE_SECRET_KEY=
LP_STRIPE_PRICE_ID=
LP_STRIPE_TRIP_PASS_PRICE_ID=
LP_STRIPE_WEBHOOK_SECRET=
# Test keys work before launch. Real checkout additionally requires production,
# live provider searches, and the published Chrome Web Store URL.
LP_LIVE_BILLING_ENABLED=false

# Resend HTTPS delivery is preferred for the hosted app; SMTP also works.
LP_RESEND_API_KEY=
# Comma-separated invited email addresses. Empty means open signup.
LP_BETA_EMAILS=

# Required for production sign-in. Local loopback preview shows a development link.
LP_SMTP_HOST=
LP_SMTP_PORT=587
LP_SMTP_STARTTLS=true
LP_SMTP_USERNAME=
LP_SMTP_PASSWORD=
LP_EMAIL_FROM=
